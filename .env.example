# ---- Required service credentials (Neon + Vercel Blob) ----

# Neon Postgres — pooled connection string from the Neon dashboard
# (Neon dashboard → your project → Connection Details → Pooled connection).
# Used BOTH locally and in production. There is no local database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Vercel Blob — read/write token (Vercel dashboard → Storage → your Blob store → .env.local snippet).
# All image uploads (portrait, projects, gallery, logos) go to Blob when this is set.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Secret used to sign admin session cookies. Use a long random string.
SESSION_SECRET="change-me-to-a-long-random-string"

# ---- Optional: contact-form email notifications ----
# Leave unset to disable email notifications entirely (messages are still
# saved in the database and visible in Admin → Messages).
RESEND_API_KEY=""
CONTACT_NOTIFY_EMAIL=""
CONTACT_FROM_EMAIL=""
